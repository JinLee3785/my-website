 if(customRows===null&&!required){wrap.style.display='none';return;}
 const sourceRows=customRows===null?filterProducts():customRows;lastRenderedRows=[...sourceRows];const rows=sortResultRows(sourceRows,document.getElementById('resultSort').value);wrap.style.display='block';count.textContent=`${rows.length.toLocaleString()}개 품목`;
 if(!rows.length){grid.innerHTML='<div class="empty-result">선택한 조건과 일치하는 제품이 없습니다.</div>';return;}
 grid.innerHTML=rows.map(p=>{
   const seenReplacementCodes=new Set();
   const replacements=[
     ['대체코드 1',p.replacementCode1],
     ['대체코드 2',p.replacementCode2],
     ['대체코드 3',p.replacementCode3]
   ].map(([label,value])=>{
     const uniqueCodes=String(value??'').split(',').map(x=>x.trim()).filter(Boolean).filter(code=>{
       const key=code.toUpperCase();
       if(seenReplacementCodes.has(key))return false;
       seenReplacementCodes.add(key);return true;
     });
     return [label,uniqueCodes.join(', ')];
   }).filter(([,v])=>v!=='');
   const replacementHtml=replacements.length?`<details class="replacement-details">
     <summary>대체코드 보기</summary>
     <div class="replacement-body">${replacements.map(([label,value])=>{const codes=String(value).split(',').map(x=>x.trim()).filter(Boolean);return `<div class="replacement-row"><div class="replacement-label">${label}</div><div class="replacement-value"><div class="replacement-chips">${codes.map(code=>`<button class="replacement-code-btn" type="button" data-replacement-code="${esc(code)}" data-origin-code="${esc(p.code)}">${esc(code)}</button>`).join('')}</div></div></div>`;}).join('')}</div>
   </details>`:'';
   const edi=String(p.ediCode??'').trim();
   return `<article class="suture-card">
     <div class="code-row"><div class="suture-code">${esc(p.code)}</div><div class="card-action-buttons"><button class="copy-code-btn" type="button" data-code="${esc(p.code)}">코드 복사</button><button class="request-ui-btn sample-cart-btn" type="button" data-sample-code="${esc(p.code)}" aria-pressed="false">샘플 담기</button></div></div>
     <div class="suture-product">${esc(p.product)}</div>
     <div class="spec-block suture-block"><div class="spec-block-title">Suture</div><div class="spec-grid suture-spec">
       <div class="spec-cell"><span class="spec-label">굵기</span><span class="spec-value">${esc(p.size)}</span></div>
       <div class="spec-cell"><span class="spec-label">길이</span><span class="spec-value">${esc(p.threadLengthLabel||((p.threadLength??'')+'cm'))}</span></div>
       <div class="spec-cell"><span class="spec-label">색상</span><span class="spec-value"><span class="result-color-chip color-${String(p.color||'').trim().toLowerCase()}">${esc(p.color)}</span></span></div>
     </div></div>
     <div class="spec-block needle-block"><div class="spec-block-title">Needle</div><div class="spec-grid needle-spec">
       <div class="spec-cell"><span class="spec-label">팁 형태</span><span class="spec-value"><span class="result-needlepoint-chip needlepoint-${String(p.needlePoint||'').trim().toLowerCase()}"><span class="needlepoint-icon" aria-hidden="true"></span>${esc(p.needlePoint)}</span></span></div>
       <div class="spec-cell"><span class="spec-label">니들 크기</span><span class="spec-value">${esc(p.needleLengthLabel||((p.needleLength??'')+'mm'))}</span></div>
       <div class="spec-cell"><span class="spec-label">니들 커브</span><span class="spec-value">${esc(p.needleShape)}</span></div>
       <div class="spec-cell"><span class="spec-label">니들 명칭</span><span class="spec-value">${esc(p.needleType)}</span></div>
     </div></div>
     <details class="product-details">
       <summary>상세정보 보기</summary>
       <div class="product-details-body">
         <div class="detail-meta"><span><b>Arm</b> ${esc(p.arm||'-')}</span><span><b>Barbed</b> ${esc(p.barbed||'-')}</span></div>
         <div class="pack-info">
           <div class="pack-item"><span class="pack-label">팩당 가닥 수</span><span class="pack-value">${p.strandsPerPack??'-'}</span></div>
           <div class="pack-item"><span class="pack-label">박스당 팩 수</span><span class="pack-value">${p.packsPerBox??'-'}</span></div>
         </div>
         <div class="edi-line"><b>EDI Code</b> ${edi?esc(edi):'-'}</div>
       </div>
     </details>
     ${replacementHtml}
   </article>`;
 }).join('');
}

const replacementModal=document.getElementById('replacementModal');
const replacementModalBody=document.getElementById('replacementModalBody');
const replacementModalClose=document.getElementById('replacementModalClose');
function productByCode(code){const q=String(code||'').trim().toUpperCase();return products.find(p=>String(p.code||'').trim().toUpperCase()===q)||null;}
function normCompare(v){return String(v??'').trim().toUpperCase().replace(/\s+/g,' ');}
function compareReplacementHtml(origin,alt){
 const val=v=>v===null||v===undefined||String(v).trim()===''?'-':String(v);
 const fields=[
  ['section','Suture'],
  ['굵기',val(origin.size),val(alt.size)],
  ['길이',val(origin.threadLengthLabel||((origin.threadLength??'')+'cm')),val(alt.threadLengthLabel||((alt.threadLength??'')+'cm'))],
  ['색상',val(origin.color),val(alt.color)],
  ['section','Needle'],
  ['팁 형태',val(origin.needlePoint),val(alt.needlePoint)],
  ['니들 크기',val(origin.needleLengthLabel),val(alt.needleLengthLabel)],
  ['니들 커브',val(origin.needleShape),val(alt.needleShape)],
  ['니들 명칭',val(origin.needleType),val(alt.needleType)]
 ];
 return `<div class="compare-code-head"><div></div><div class="compare-code-box"><div class="compare-code-label">현재 제품</div><div class="compare-code">${esc(origin.code)}</div><div class="compare-product">${esc(origin.product)}</div></div><div class="compare-code-box"><div class="compare-code-label">대체 제품</div><div class="compare-code alt">${esc(alt.code)}</div><div class="compare-product">${esc(alt.product)}</div></div></div>
 <div class="compare-table">${fields.map(row=>{if(row[0]==='section')return `<div class="compare-row compare-section-row"><div class="compare-section">${esc(row[1])}</div></div>`;const changed=normCompare(row[1])!==normCompare(row[2]);return `<div class="compare-row"><div class="compare-col compare-label">${esc(row[0])}</div><div class="compare-col compare-current${changed?' changed':''}">${esc(row[1])}</div><div class="compare-col compare-alt${changed?' changed':''}">${esc(row[2])}</div></div>`;}).join('')}</div>
 <div class="compare-legend">※ 값이 다른 항목은 대체 제품 칸을 붉은색으로 강조합니다.</div>
 <div class="modal-actions"><button class="modal-btn" type="button" data-modal-close>닫기</button><button class="modal-btn primary" type="button" data-go-product="${esc(alt.code)}">이 제품으로 이동</button></div>`;
}
function openReplacementModal(code,originCode){
 const alt=productByCode(code),origin=productByCode(originCode);
 if(alt&&origin){replacementModalBody.innerHTML=compareReplacementHtml(origin,alt);}
 else if(alt){replacementModalBody.innerHTML=`<div class="modal-code">${esc(alt.code)}</div><div class="modal-product">${esc(alt.product)}</div><div class="modal-notfound">현재 제품 정보를 찾지 못해 비교표를 만들 수 없습니다.</div><div class="modal-actions"><button class="modal-btn" type="button" data-modal-close>닫기</button><button class="modal-btn primary" type="button" data-go-product="${esc(alt.code)}">이 제품으로 이동</button></div>`;}
 else{replacementModalBody.innerHTML=`<div class="modal-notfound"><b>${esc(code)}</b><br>현재 내장 데이터에서 해당 대체코드를 찾을 수 없습니다.</div><div class="modal-actions"><button class="modal-btn" type="button" data-modal-close>닫기</button></div>`;}
 replacementModal.hidden=false;document.body.style.overflow='hidden';
}
function closeReplacementModal(){replacementModal.hidden=true;document.body.style.overflow='';}
replacementModalClose.addEventListener('click',closeReplacementModal);
replacementModal.addEventListener('click',e=>{if(e.target===replacementModal||e.target.closest('[data-modal-close]')){closeReplacementModal();return;}const go=e.target.closest('[data-go-product]');if(go){const p=productByCode(go.dataset.goProduct);closeReplacementModal();if(p){renderResults([p]);document.getElementById('searchResults').scrollIntoView({behavior:'smooth',block:'start'});}}});
document.addEventListener('keydown',e=>{if(e.key==='Escape'&&!replacementModal.hidden)closeReplacementModal();});
document.getElementById('resultGrid').addEventListener('click',e=>{const btn=e.target.closest('.replacement-code-btn');if(!btn)return;e.preventDefault();e.stopPropagation();openReplacementModal(btn.dataset.replacementCode,btn.dataset.originCode);});

document.getElementById('resultSort').addEventListener('change',()=>{if(lastRenderedRows.length)renderResults(lastRenderedRows);});
const codeSearchToggle=document.getElementById('codeSearchToggle');
const codeSearchPanel=document.getElementById('codeSearchPanel');
const codeSearchInput=document.getElementById('codeSearchInput');
const codeSearchGo=document.getElementById('codeSearchGo');
function toggleCodeSearch(force){const open=typeof force==='boolean'?force:codeSearchPanel.hidden;codeSearchPanel.hidden=!open;codeSearchToggle.setAttribute('aria-expanded',String(open));if(open)setTimeout(()=>codeSearchInput.focus(),0);}
codeSearchToggle.addEventListener('click',()=>toggleCodeSearch());
function runCodeSearch(){
 const q=codeSearchInput.value.trim().toUpperCase();
 const wrap=document.getElementById('searchResults'),grid=document.getElementById('resultGrid'),count=document.getElementById('resultCount');
 if(!q){wrap.style.display='block';count.textContent='';grid.innerHTML='<div class=\"empty-result\">검색할 제품 코드를 입력해 주세요.</div>';return;}
 const exact=products.filter(p=>String(p.code||'').trim().toUpperCase()===q);
 const rows=exact.length?exact:products.filter(p=>String(p.code||'').trim().toUpperCase().includes(q));
 if(!rows.length){wrap.style.display='block';count.textContent='0개 품목';grid.innerHTML='<div class=\"empty-result\">일치하는 제품 코드가 없습니다.</div>';}else{renderResults(rows);}
 toggleCodeSearch(false);
 wrap.scrollIntoView({behavior:'smooth',block:'start'});
}
codeSearchGo.addEventListener('click',runCodeSearch);
codeSearchInput.addEventListener('keydown',e=>{if(e.key==='Enter'){e.preventDefault();runCodeSearch();}else if(e.key==='Escape'){toggleCodeSearch(false);}});
document.addEventListener('click',e=>{if(!e.target.closest('.code-search-wrap')&&!codeSearchPanel.hidden)toggleCodeSearch(false);});

document.getElementById('resultGrid').addEventListener('click',async e=>{
 const btn=e.target.closest('.copy-code-btn');if(!btn)return;
 const code=btn.dataset.code||'';
 try{
  if(navigator.clipboard&&window.isSecureContext){await navigator.clipboard.writeText(code);}else{const ta=document.createElement('textarea');ta.value=code;ta.style.position='fixed';ta.style.opacity='0';document.body.appendChild(ta);ta.select();document.execCommand('copy');ta.remove();}
  btn.textContent='복사 완료 ✓';btn.classList.add('copied');setTimeout(()=>{btn.textContent='코드 복사';btn.classList.remove('copied');},1200);
 }catch(err){console.warn('코드 복사 실패',err);}
