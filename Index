 if(doubleOnly&&threadText!=='전체'){if(tMin&&tMax)threadText=`각 ${tMin} ~ ${tMax} (Double Arm)`;else if(tMin)threadText=`각 ${tMin} 이상 (Double Arm)`;else threadText=`각 ${tMax} 이하 (Double Arm)`;}
 setCard('card_absorbability','s_absorbability',absorbability.length?absorbability[0]:'전체',absorbability.length>0);
 setCard('card_size','s_size',size.length?size.join(', '):'전체',size.length>0);setCard('card_needle','s_needle',nonNeedle?'Non-Needle':range(nMin,nMax),nonNeedle||Boolean(nMin||nMax));setCard('card_thread','s_thread',threadText,Boolean(tMin||tMax));
 setCard('card_tip','s_tip',tip.length?tip.join(', '):'전체',tip.length>0);setCard('card_circle','s_circle',circle.length?circle.join(', '):'전체',circle.length>0);setCard('card_color','s_color',color.length?color.join(', '):'전체',color.length>0);
 setCard('card_barbed','s_barbed',barbed.length?barbed[0]:'전체',barbed.length>0);setCard('card_arm','s_arm',arm.length?arm[0]:'전체',arm.length>0);setCard('card_controlRelease','s_controlRelease',controlRelease?'Control Release':'전체',controlRelease);setCard('card_product','s_product',productFilter||'전체',Boolean(productFilter));
 document.getElementById('searchResults').style.display='none';
 document.getElementById('selectedSpecsSummary').classList.remove('results-sticky');
}
document.getElementById('searchButton').addEventListener('click',()=>{
