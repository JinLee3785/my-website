// Sample cart interaction
const sampleCart=new Set();
function refreshSampleCartUI(){
  const bar=document.getElementById('sampleCartBar');
  const countEl=document.getElementById('sampleCartCount');
  const count=sampleCart.size;
  if(countEl)countEl.textContent=`샘플 ${count}개 담김`;
  if(bar)bar.hidden=count===0;
  document.querySelectorAll('.sample-cart-btn[data-sample-code]').forEach(btn=>{
    const code=String(btn.dataset.sampleCode||'').trim();
    const added=sampleCart.has(code);
    btn.classList.toggle('added',added);
    btn.textContent=added?'✓ 담김':'샘플 담기';
    btn.setAttribute('aria-pressed',added?'true':'false');
  });
}
document.addEventListener('click',function(e){
  const btn=e.target.closest('.sample-cart-btn[data-sample-code]');
  if(!btn)return;
  const code=String(btn.dataset.sampleCode||'').trim();
  if(!code)return;
  if(sampleCart.has(code))sampleCart.delete(code);else sampleCart.add(code);
  refreshSampleCartUI();
});
