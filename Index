document.querySelectorAll('.chips').forEach(g=>g.addEventListener('click',e=>{if(!e.target.classList.contains('chip'))return;if(g.id==='absorbability'){g.querySelectorAll('.chip').forEach(c=>c.classList.remove('active'));e.target.classList.add('active');}else if(['arm','barbed'].includes(g.id)){const wasActive=e.target.classList.contains('active');g.querySelectorAll('.chip').forEach(c=>c.classList.remove('active'));if(!wasActive)e.target.classList.add('active');}else{e.target.classList.toggle('active');}update();}));
function fill(id,a,s=''){document.getElementById(id).innerHTML='<option value="">선택</option>'+a.map(v=>`<option value="${v}${s}">${v}${s}</option>`).join('');}
fill('threadMin',thread,'cm');fill('threadMax',thread,'cm');fill('needleMin',needle);fill('needleMax',needle);
['threadMin','threadMax','needleMin','needleMax'].forEach(id=>document.getElementById(id).addEventListener('change',update));

const threadSliderMin=document.getElementById('threadSliderMin');
const threadSliderMax=document.getElementById('threadSliderMax');
function syncThreadSlider(changed){
 let minIndex=Number(threadSliderMin.value),maxIndex=Number(threadSliderMax.value);
 if(minIndex>maxIndex){if(changed==='min')maxIndex=minIndex;else minIndex=maxIndex;threadSliderMin.value=String(minIndex);threadSliderMax.value=String(maxIndex);}
 const isFull=minIndex===0&&maxIndex===thread.length-1;
 document.getElementById('threadMin').value=isFull?'':thread[minIndex]+'cm';
 document.getElementById('threadMax').value=isFull?'':thread[maxIndex]+'cm';
 document.getElementById('threadRangeReadout').textContent=isFull?'전체':thread[minIndex]+'cm ~ '+thread[maxIndex]+'cm';
 const denominator=Math.max(1,thread.length-1),fill=document.getElementById('threadSliderFill');
 fill.style.left=(minIndex/denominator*100)+'%';fill.style.right=((denominator-maxIndex)/denominator*100)+'%';
 update();
}
threadSliderMin.addEventListener('input',()=>syncThreadSlider('min'));
threadSliderMax.addEventListener('input',()=>syncThreadSlider('max'));
syncThreadSlider();

document.getElementById('nonNeedle').addEventListener('change',e=>{const on=e.target.checked;document.getElementById('needleRange').classList.toggle('disabled',on);if(on){document.getElementById('needleMin').value='';document.getElementById('needleMax').value='';}update();});
document.getElementById('controlRelease').addEventListener('change',update);
document.getElementById('productFilter').addEventListener('change',update);
document.querySelectorAll('.reset-btn').forEach(button=>button.addEventListener('click',()=>resetFilter(button.dataset.reset)));
function resetFilter(type){const chipGroups=['size','tip','circle','arm','color','absorbability','barbed'];if(chipGroups.includes(type)){document.querySelectorAll(`#${type} .chip`).forEach(chip=>chip.classList.remove('active'));}else if(type==='thread'){document.getElementById('threadMin').value='';document.getElementById('threadMax').value='';threadSliderMin.value='0';threadSliderMax.value=String(thread.length-1);syncThreadSlider();}else if(type==='needle'){document.getElementById('needleMin').value='';document.getElementById('needleMax').value='';document.getElementById('nonNeedle').checked=false;document.getElementById('needleRange').classList.remove('disabled');}else if(type==='controlRelease'){document.getElementById('controlRelease').checked=false;}else if(type==='product'){document.getElementById('productFilter').value='';}update();}
const toggleOptions=document.getElementById('toggleOptions'),optionalFilters=document.getElementById('optionalFilters');
toggleOptions.addEventListener('click',()=>{const willOpen=optionalFilters.hidden;optionalFilters.hidden=!willOpen;toggleOptions.textContent=willOpen?'옵션 숨기기':'눌러서 옵션 더 보기';toggleOptions.setAttribute('aria-expanded',String(willOpen));});
function vals(id){return [...document.querySelectorAll(`#${id} .chip.active`)].map(x=>x.textContent).filter(v=>!(id==='absorbability'&&v==='전체'));}
function hasAbsorbabilitySelection(){return Boolean(document.querySelector('#absorbability .chip.active'));}

function setCard(c,v,t,on){document.getElementById(v).textContent=t;const el=document.getElementById(c);el.classList.toggle('selected',on);if(['card_thread','card_tip','card_circle','card_color','card_barbed','card_arm'].includes(c)){el.style.display=on?'block':'none';}}

function range(min,max){if(min&&max)return `${min} ~ ${max}`;if(min)return `${min} 이상`;if(max)return `${max} 이하`;return '전체';}
function n(v){const x=Number(v);return Number.isFinite(x)?x:null;}
function esc(v){return String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));}
function matchesRange(value,min,max){
  if(value===null||value===undefined||value==='') return false;
  const x=parseFloat(String(value).replace(',','.'));
  const lo=min===''||min===null||min===undefined ? null : parseFloat(String(min).replace(',','.'));
  const hi=max===''||max===null||max===undefined ? null : parseFloat(String(max).replace(',','.'));
  if(!Number.isFinite(x)) return false;
  if(lo!==null && Number.isFinite(lo) && x<lo) return false;
  if(hi!==null && Number.isFinite(hi) && x>hi) return false;
  return true;
}
function filterProducts(){
 const absorbability=vals('absorbability'),size=vals('size'),tip=vals('tip'),circle=vals('circle'),color=vals('color'),barbed=vals('barbed'),arm=vals('arm');
 const tMin=document.getElementById('threadMin').value,tMax=document.getElementById('threadMax').value,nMin=document.getElementById('needleMin').value,nMax=document.getElementById('needleMax').value;
 const nonNeedle=document.getElementById('nonNeedle').checked;
 const controlRelease=document.getElementById('controlRelease').checked;
 const productFilter=document.getElementById('productFilter').value;
 const hasNeedleRange=!nonNeedle&&Boolean(nMin||nMax),hasThreadRange=Boolean(tMin||tMax);
 return products.filter(p=>
   (!absorbability.length||absorbability.includes(p.absorbability))&&
   (!nonNeedle||String(p.needleType||'').trim().toUpperCase()==='NN')&&
   (!size.length||size.includes(p.size))&&
   (!tip.length||tip.some(t=>t==='Cutting'?['Cutting','Tapercut','Spatular'].includes(p.needlePoint):t==='Taper'?['Taper','Blunt','ETHIGUARD','Ethiguard'].includes(p.needlePoint):t===p.needlePoint))&&
   (!circle.length||circle.includes(p.needleShape))&&
   (!color.length||color.includes(p.color))&&
   (!barbed.length||barbed.includes(p.barbed))&&
   (!arm.length||arm.includes(p.arm))&&
   (!controlRelease||['CR4','CR8'].includes(String(p.needleConfiguration||'').trim().toUpperCase()))&&
   (!productFilter||String(p.product||'')===productFilter)&&
   (!hasNeedleRange||matchesRange(p.needleLength,nMin,nMax))&&
   (!hasThreadRange||matchesRange(p.threadLength,tMin,tMax))
 );
}
let lastRenderedRows=[];
function sutureSizeRank(v){
 const s=String(v??'').trim().toUpperCase();
 const thick={'#7':0,'#6':1,'#5':2,'#4':3,'#3':4,'#2':5,'#1':6,'0':7,'1-0':7,'1/0':7,'2-0':8,'2/0':8,'3-0':9,'3/0':9,'4-0':10,'4/0':10,'5-0':11,'5/0':11,'6-0':12,'6/0':12,'7-0':13,'7/0':13,'8-0':14,'8/0':14,'9-0':15,'9/0':15,'10-0':16,'10/0':16,'11-0':17,'11/0':17};
 return Object.prototype.hasOwnProperty.call(thick,s)?thick[s]:999;
}
function sortResultRows(rows,mode){
 const a=[...rows];
 if(mode==='default'||!mode){const abczRank={A:0,B:1,C:2,Z:3,'NO SALES':4};a.sort((x,y)=>(abczRank[String(x.abcz||'').trim().toUpperCase()]??5)-(abczRank[String(y.abcz||'').trim().toUpperCase()]??5));return a;}
 const num=v=>Number.isFinite(Number(v))?Number(v):null;
 const cmpNum=(x,y,dir=1)=>{const a1=num(x),b1=num(y);if(a1===null&&b1===null)return 0;if(a1===null)return 1;if(b1===null)return -1;return (a1-b1)*dir;};
 if(mode==='size-desc')a.sort((x,y)=>sutureSizeRank(x.size)-sutureSizeRank(y.size));
 else if(mode==='size-asc')a.sort((x,y)=>sutureSizeRank(y.size)-sutureSizeRank(x.size));
 else if(mode==='thread-asc')a.sort((x,y)=>cmpNum(x.threadLength,y.threadLength,1));
 else if(mode==='thread-desc')a.sort((x,y)=>cmpNum(x.threadLength,y.threadLength,-1));
 else if(mode==='needle-asc')a.sort((x,y)=>cmpNum(x.needleLength,y.needleLength,1));
 else if(mode==='needle-desc')a.sort((x,y)=>cmpNum(x.needleLength,y.needleLength,-1));
 else if(mode==='code-asc')a.sort((x,y)=>String(x.code||'').localeCompare(String(y.code||''),undefined,{numeric:true,sensitivity:'base'}));
 return a;
}
function renderResults(customRows=null){
